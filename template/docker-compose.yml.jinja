# Runs the production image locally with its own Postgres:
#   docker compose up --build    ->  http://localhost:8000
services:
  postgres:
    image: postgres:18
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ db_name }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-{{ db_name }}_password}
      POSTGRES_DB: {{ db_name }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ db_name }}"]
      interval: 5s
      timeout: 5s
      retries: 10
    volumes:
      - postgres_data:/var/lib/postgresql

  app:
    build: .
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "8000:8000"
    environment:
      DATABASE_URL: postgresql://{{ db_name }}:${POSTGRES_PASSWORD:-{{ db_name }}_password}@postgres:5432/{{ db_name }}
      ENVIRONMENT: ${ENVIRONMENT:-production}
      CORS_ORIGINS: '["http://localhost:8000"]'

volumes:
  postgres_data:
