{
  "name": "{{ project_slug }}-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run routes:generate && vite",
    "build": "npm run routes:generate && npm run api:generate && tsc && vite build",
    "build:ci": "npm run routes:generate && tsc && vite build",
    "preview": "vite preview",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "api:generate": "orval && prettier --write src/api/generated --log-level warn",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\" \"tests/**/*.{ts,tsx}\"",
    "type-check": "npm run routes:generate && tsc --noEmit",
    "test": "npm run routes:generate && vitest run",
    "test:watch": "npm run routes:generate && vitest",
    "test:unit": "vitest run --project unit",
    "knip": "npm run routes:generate && knip",
    "deps:check": "depcruise src tests --config .dependency-cruiser.cjs",
    "deps:graph": "depcruise src --config .dependency-cruiser.cjs --include-only \"^src\" --exclude \"^src/api/generated\" --output-type mermaid",
    "duplication-check": "jscpd --no-tips"
  },
  "dependencies": {
{%- if ui == 'mui' %}
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.4.0",
{%- endif %}
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.41",
    "axios": "^1.20.0",
{%- if ui == 'shadcn' %}
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "radix-ui": "^1.7.0",
{%- endif %}
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
{%- if ui == 'shadcn' %},
    "tailwind-merge": "^3.7.0"
{%- endif %}
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
{%- if ui == 'shadcn' %}
    "@tailwindcss/vite": "^4.3.3",
{%- endif %}
    "@tanstack/router-cli": "^1.167.40",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jscpd": "^5.3.2",
    "knip": "^6.31.0",
    "msw": "^2.15.0",
    "orval": "8.28.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
{%- if ui == 'shadcn' %}
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
{%- endif %}
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.3.0"
  },
  "msw": {
    "workerDirectory": [
      "tests/public"
    ]
  }
}
